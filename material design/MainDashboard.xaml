<Window x:Class="material_design.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления кафе-баром 'Удача'"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="ModuleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF3F51B5"/>
                    <Setter Property="Background" Value="#FFF3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="28" Margin="0,0,15,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock Text="СИСТЕМА УПРАВЛЕНИЯ"
                                FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Кафе-бар 'Удача'"
                                FontSize="16" Foreground="White" Opacity="0.9"/>

                    </StackPanel>
                </StackPanel>

                <!-- Информация о пользователе -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="tbUserInfo" Foreground="White" FontSize="14" 
                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Выйти" Click="LogoutButton_Click"
                           Background="Transparent" BorderBrush="White" 
                           Foreground="White" Padding="10,5"/>

                </StackPanel>
                <Button x:Name="btnMenu" 
                Content="☰ Меню" 
                Background="Transparent" 
                Foreground="White" 
                BorderThickness="0"
                Cursor="Hand"
                FontSize="14"
                Margin="798,-1,25,1"
                Click="MenuButton_Click"/>

                <Popup x:Name="popupMenu" 
       PlacementTarget="{Binding ElementName=btnMenu}"
       Placement="Bottom"
       StaysOpen="False"
       AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4"
            Padding="5" MinWidth="200">
                        <StackPanel>
                            <MenuItem Header="💾 Резервное копирование БД" Click="BackupDatabase_Click"/>
                            <MenuItem Header="🔄 Восстановление из копии" Click="RestoreDatabase_Click"/>
                            <Separator/>
                            <MenuItem Header="ℹ️ О программе" Click="AboutProgram_Click"/>
                            <Separator/>
                            <MenuItem Header="🚪 Выход" Click="Logout_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>
            
        </Border>


        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Приветствие -->
                <TextBlock Grid.Row="0" Name="tbWelcome" FontSize="16" Margin="0,0,0,20"
                          TextWrapping="Wrap"/>

                <!-- Модули системы -->
                <ItemsControl Grid.Row="1" Name="modulesContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModuleBorderStyle}" 
                                   Width="280" Height="150"
                                   MouseDown="Module_MouseDown"
                                   Tag="{Binding Name}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="40" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                              HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" 
                                              HorizontalAlignment="Center" TextAlignment="Center" 
                                              Foreground="Gray" TextWrapping="Wrap" Width="240"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10">
            <TextBlock Text="Кафе-бар 'Удача' - Система управления залом" 
                      HorizontalAlignment="Center" Foreground="Gray"/>
        </Border>
    </Grid>
</Window>