<Window x:Class="material_design.MenuManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление меню" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🍽️" FontSize="24" Margin="0,0,15,0" Foreground="White"/>
                <TextBlock Text="Управление меню" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Список позиций меню -->
            <DataGrid Grid.Column="0" Name="dgMenuItems" AutoGenerateColumns="False"
                     Margin="0,0,10,0" SelectionChanged="dgMenuItems_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id_menu_item}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding item_name}" Width="200"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoriesMenu.title_category}" Width="150"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding cost_item, StringFormat={}{0:C}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Форма добавления/редактирования -->
            <Border Grid.Column="1" Background="#FFF5F5F5" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Добавить/Редактировать позицию" 
                              FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Название:" Margin="0,0,0,5"/>
                    <TextBox Name="txtItemName" Margin="0,0,0,10"/>

                    <TextBlock Text="Категория:" Margin="0,0,0,5"/>
                    <ComboBox Name="cbCategory" DisplayMemberPath="title_category" 
                             SelectedValuePath="id_category" Margin="0,0,0,10"/>

                    <TextBlock Text="Цена:" Margin="0,0,0,5"/>
                    <TextBox Name="txtCost" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сохранить" Click="SaveMenuItem_Click" 
                               Background="#FF3F51B5" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Удалить" Click="DeleteMenuItem_Click" 
                               Background="#FFD32F2F" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Очистить" Click="ClearForm_Click" 
                               Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Главное меню" Click="MainMenuButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>