<Window x:Class="material_design.ReservationManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление бронированием" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📅" FontSize="24" Margin="0,0,15,0" Foreground="White"/>
                <TextBlock Text="Управление бронированием" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Список бронирований -->
            <DataGrid Grid.Column="0" Name="dgReservations" AutoGenerateColumns="False"
          Margin="0,0,10,0" SelectionChanged="dgReservations_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id_reservation}" Width="50"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Clients.name_client}" Width="150"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employees.name_employee}" Width="150"/>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding reservation_date, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Гостей" Binding="{Binding guests_count}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Форма добавления/редактирования -->
            <Border Grid.Column="1" Background="#FFF5F5F5" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Добавить/Редактировать бронирование" 
                              FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Клиент:" Margin="0,0,0,5"/>
                    <ComboBox Name="cbClient" DisplayMemberPath="name_client" 
                             SelectedValuePath="id_client" Margin="0,0,0,10"/>

                    <TextBlock Text="Сотрудник:" Margin="0,0,0,5"/>
                    <ComboBox Name="cbEmployee" DisplayMemberPath="name_employee" 
                             SelectedValuePath="id_employee" Margin="0,0,0,10"/>

                    <TextBlock Text="Дата и время:" Margin="0,0,0,5"/>
                    <DatePicker Name="dpReservationDate" Margin="0,0,0,5"/>
                    <ComboBox Name="cbReservationTime" Margin="0,0,0,10">
                        <ComboBoxItem Content="18:00"/>
                        <ComboBoxItem Content="18:30"/>
                        <ComboBoxItem Content="19:00"/>
                        <ComboBoxItem Content="19:30"/>
                        <ComboBoxItem Content="20:00"/>
                        <ComboBoxItem Content="20:30"/>
                        <ComboBoxItem Content="21:00"/>
                    </ComboBox>

                    <TextBlock Text="Количество гостей:" Margin="0,0,0,5"/>
                    <TextBox Name="txtGuestsCount" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сохранить" Click="SaveReservation_Click" 
                               Background="#FF3F51B5" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Удалить" Click="DeleteReservation_Click" 
                               Background="#FFD32F2F" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Очистить" Click="ClearForm_Click" 
                               Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Главное меню" Click="MainMenuButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>