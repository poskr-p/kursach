<Window x:Class="material_design.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤" FontSize="24" Margin="0,0,15,0" Foreground="White"/>
                <TextBlock Text="Управление пользователями" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Список пользователей -->
            <DataGrid Grid.Column="0" Name="dgUsers" AutoGenerateColumns="False"
                     Margin="0,0,10,0" SelectionChanged="dgUsers_SelectionChanged"
                     CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                    <DataGridTextColumn Header="Уровень доступа" Binding="{Binding accessLevel}" Width="100"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Форма добавления/редактирования -->
            <Border Grid.Column="1" Background="#FFF5F5F5" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Добавить/Редактировать пользователя" 
                              FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Логин:" Margin="0,0,0,5"/>
                    <TextBox Name="txtLogin" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
                    <PasswordBox Name="txtPassword" Margin="0,0,0,10"/>

                    <TextBlock Text="Уровень доступа:" Margin="0,0,0,5"/>
                    <ComboBox Name="cbAccessLevel" DisplayMemberPath="Value" 
                             SelectedValuePath="Key" Margin="0,0,0,15"
                             SelectionChanged="dgUsers_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="btnSave" Content="Сохранить" Click="SaveUser_Click" 
                               Background="#FF3F51B5" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0"/>
                        <Button Name="btnDelete" Content="Удалить" Click="DeleteUser_Click" 
                               Background="#FFD32F2F" Foreground="White" 
                               Padding="10,5" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button Content="Очистить" Click="ClearForm_Click" 
                               Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Главное меню" Click="MainMenuButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>