<Window x:Class="material_design.OrderTakingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прием заказов" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📝" FontSize="24" Margin="0,0,15,0" Foreground="White"/>
                <TextBlock Text="Прием заказов" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Меню -->
            <GroupBox Grid.Column="0" Header="Меню" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фильтры -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Name="cbCategories" Width="200" Margin="0,0,10,0"
                                 SelectionChanged="cbCategories_SelectionChanged"/>
                        <TextBox Name="tbSearch" Width="200" 
                                Text="Поиск..." 
                                GotFocus="SearchBox_GotFocus"
                                LostFocus="SearchBox_LostFocus"/>
                    </StackPanel>

                    <!-- Список позиций меню -->
                    <DataGrid Grid.Row="1" Name="dgMenu" AutoGenerateColumns="False"
                             SelectionChanged="dgMenu_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Позиция" Binding="{Binding item_name}" Width="*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.title_category}" Width="150"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding cost_item, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+" Click="AddToOrder_Click" 
                                               Padding="5" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- Текущий заказ -->
            <GroupBox Grid.Column="1" Header="Текущий заказ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Информация о заказе -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <ComboBox Name="cbClients" DisplayMemberPath="name_client" 
                                 Width="200" Margin="0,0,0,5"/>
                        <TextBlock Name="tbOrderTotal" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>

                    <!-- Список позиций заказа -->
                    <DataGrid Grid.Row="1" Name="dgOrderItems" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Позиция" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="80"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="80"/>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Click="RemoveFromOrder_Click" 
                                               Padding="2" Foreground="Red"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Очистить" Click="ClearOrder_Click" Margin="0,0,10,0"/>
                        <Button Content="Создать заказ" Click="CreateOrder_Click" 
                               Background="#FF3F51B5" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF5F5F5" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Главное меню" Click="MainMenuButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>