<Window x:Class="material_design.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр таблиц" Height="700" Width="1200"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Width="200" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Таблицы" FontSize="16" FontWeight="Bold" Margin="10,20,10,10"/>
                
                <ListView Name="lvTables" SelectionChanged="lvTables_SelectionChanged" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="10,5" FontSize="14"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Центр: Таблица -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок таблицы -->
            <TextBlock Name="tbTableTitle" Grid.Row="0" Text="Выберите таблицу" 
                       FontSize="18" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

            <!-- Таблица -->
            <DataGrid Name="dataGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="True"
                      SelectionChanged="dataGrid_SelectionChanged" CanUserAddRows="False"/>

            <!-- Статус -->
            <TextBlock Name="tbStatus" Grid.Row="2" Margin="10,5" Foreground="Gray"/>
        </Grid>

        <!-- Правая панель: Редактирование -->
        <Border Grid.Column="2" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Name="spEditPanel" Margin="10" Visibility="Collapsed">
                    <TextBlock Name="tbEditTitle" Text="Редактирование" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <!-- Поля для редактирования будут добавляться динамически -->
                    <StackPanel Name="spFields"/>
                    
                    <!-- Кнопки CRUD -->
                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Name="btnAdd" Content="Добавить" Click="btnAdd_Click" Margin="0,0,10,0" Width="80"/>
                        <Button Name="btnEdit" Content="Сохранить" Click="btnEdit_Click" Margin="0,0,10,0" Width="80"/>
                        <Button Name="btnDelete" Content="Удалить" Click="btnDelete_Click" Width="80"/>
                    </StackPanel>
                    
                    <Button Name="btnBack" Content="Главное меню" Click="btnBack_Click" 
                            Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>