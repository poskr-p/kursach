<Window x:Class="material_design.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты и заказы" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Width="200" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Разделы" FontSize="16" FontWeight="Bold" Margin="10,20,10,10"/>
                <ListView Name="lvTables" SelectionChanged="lvTables_SelectionChanged" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="10,5" FontSize="14"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Центр: Таблица -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок таблицы -->
            <TextBlock Name="tbTableTitle" Grid.Row="0" Text="Выберите раздел" 
                       FontSize="18" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

            <!-- Таблица (только для чтения) -->
            <DataGrid Name="dataGrid" Grid.Row="1" Margin="10" 
                      AutoGenerateColumns="True" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"/>

            <!-- Статус и кнопка -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <TextBlock Name="tbStatus" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray"/>
                <Button Name="btnBack" Content="Главное меню" Click="btnBack_Click" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>